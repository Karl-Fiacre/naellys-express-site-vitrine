---
// Téléchargement de l'application : boutons Google Play et App Store, « bientôt disponible »
// jusqu'à la publication (remplacer les liens par ceux des fiches une fois publiées).
const PLAY = '';
const APP_STORE = '';
---

<section class="section telechargement">
  <div class="conteneur boite" data-reveal="zoom">
    <div class="raies" aria-hidden="true"><span class="epaisse"></span><span class="fine"></span></div>
    <div class="texte">
      <p class="surtitre">L’application</p>
      <h2>Toute la livraison<br />dans votre poche.</h2>
      <p>Commandez, suivez votre coursier en direct, téléchargez vos tickets et vos factures. Une seule application, pour les clients comme pour les livreurs.</p>
      <div class="magasins">
        <a class="magasin" href={PLAY || undefined} aria-disabled={PLAY ? undefined : 'true'}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3.6 2.2 13.4 12l-9.8 9.8c-.4-.2-.6-.6-.6-1.1V3.3c0-.5.2-.9.6-1.1Zm10.8 10.8 2.6 2.6-11.2 6.4 8.6-9Zm3.6-3.6 3 1.7c.8.5.8 1.3 0 1.8l-3 1.7-2.8-2.6 2.8-2.6ZM5.8 2 17 8.4l-2.6 2.6-8.6-9Z"/></svg>
          <span><small>{PLAY ? 'Disponible sur' : 'Bientôt sur'}</small>Google Play</span>
        </a>
        <a class="magasin" href={APP_STORE || undefined} aria-disabled={APP_STORE ? undefined : 'true'}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.4 2-3.6 2.1-3.7-1.2-1.7-3-1.9-3.6-1.9-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.5-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.3.8 1.4 0 2.3-1.2 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.8-1-2.8-4.3ZM13.9 5.3c.7-.8 1.2-2 1-3.2-1 .1-2.2.7-2.9 1.5-.7.7-1.3 1.9-1.1 3.1 1.1.1 2.3-.6 3-1.4Z"/></svg>
          <span><small>{APP_STORE ? 'Télécharger dans' : 'Bientôt sur'}</small>App Store</span>
        </a>
      </div>
    </div>
    <img class="embleme" src="/images/embleme.png" alt="" width="360" height="360" loading="lazy" data-parallaxe="-0.04" />
  </div>
</section>

<style>
  .boite { position: relative; overflow: hidden; display: grid; grid-template-columns: 1.3fr 0.7fr; align-items: center; gap: 30px; padding: clamp(36px, 6vw, 80px); border-radius: 44px; background: radial-gradient(circle at 85% 20%, rgb(232 114 44 / 0.35), transparent 50%), var(--navy); color: var(--on-navy-muted); box-shadow: var(--ombre); }
  .boite h2 { color: #fff; }
  .texte { position: relative; }
  .magasins { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }
  .magasin { display: inline-flex; align-items: center; gap: 12px; padding: 12px 22px 12px 16px; border-radius: 16px; background: #000; color: #fff; text-decoration: none; border: 1px solid rgb(255 255 255 / 0.2); transition: transform 0.35s var(--courbe); }
  .magasin:not([aria-disabled]):hover { transform: translateY(-3px); }
  .magasin[aria-disabled] { opacity: 0.8; cursor: default; }
  .magasin svg { width: 28px; height: 28px; }
  .magasin span { display: flex; flex-direction: column; font-family: var(--font-titre); font-weight: 700; font-size: 1.1rem; line-height: 1.1; }
  .magasin small { font-family: var(--font-texte); font-weight: 500; font-size: 0.72rem; color: #c6cede; }
  .embleme { position: relative; width: 100%; max-width: 300px; justify-self: center; background: #fff; border-radius: 56px; padding: 24px; box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.6); transform: rotate(-6deg); }
  @media (max-width: 820px) { .boite { grid-template-columns: 1fr; } .embleme { max-width: 180px; } }
</style>
