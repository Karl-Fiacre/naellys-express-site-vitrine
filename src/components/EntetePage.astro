---
// En-tête des pages intérieures : surtitre, grand titre, chapeau, diagonales et halo.
interface Props { surtitre: string; titre: string; chapeau: string; }
const { surtitre, titre, chapeau } = Astro.props;
---

<section class="entete-page">
  <div class="halo" aria-hidden="true" data-parallaxe="0.15"></div>
  <div class="raies" aria-hidden="true"><span class="epaisse"></span><span class="fine"></span></div>
  <div class="conteneur" style="position:relative">
    <p class="surtitre" data-reveal>{surtitre}</p>
    <h1 data-reveal style="--delai:80ms" set:html={titre} />
    <p class="chapeau" data-reveal style="--delai:160ms">{chapeau}</p>
    <slot />
  </div>
</section>
