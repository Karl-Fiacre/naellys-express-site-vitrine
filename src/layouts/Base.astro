---
// Mise en page commune : métadonnées, transitions entre pages (Astro ClientRouter, API View
// Transitions du navigateur), en-tête, pied de page, bouton WhatsApp, barre de progression.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { SOCIETE, COMMUNES } from '../data/site';

interface Props {
  titre: string;
  description: string;
  /** Titre complet de l'onglet et des résultats de recherche (sinon « titre — NAËLLYS EXPRESS »). */
  titreSeo?: string;
  /** Fil d'Ariane (données structurées), sans l'accueil. */
  fil?: { nom: string; url: string }[];
  /** Données structurées propres à la page (FAQ, service local…). */
  jsonLd?: Record<string, unknown>[];
  /** Page à ne pas indexer (404). */
  noindex?: boolean;
}
const { titre, description, titreSeo, fil = [], jsonLd = [], noindex = false } = Astro.props;
const titreComplet =
  titreSeo ??
  (titre === SOCIETE.nom ? `Livraison de colis à moto à Abidjan — ${SOCIETE.nom}` : `${titre} — ${SOCIETE.nom}`);
const canonique = new URL(Astro.url.pathname, Astro.site);
const SITE = 'https://naellys-express.com';
// Fiche de l'entreprise (référencement local, 16/10/2026) : mêmes nom, adresse et téléphone que
// sur Google Business Profile et les annuaires (cohérence exigée par les moteurs de recherche).
const entreprise = {
  '@type': 'LocalBusiness',
  '@id': `${SITE}/#entreprise`,
  name: SOCIETE.nom,
  legalName: `${SOCIETE.nom} ${SOCIETE.forme}`,
  description:
    'Entreprise de livraison de colis à moto à Abidjan : coursiers vérifiés, suivi en direct, remise sécurisée par code, offres pour particuliers, entreprises et partenaires.',
  url: SITE,
  logo: `${SITE}/images/logo.png`,
  image: `${SITE}/images/coursier.jpg`,
  telephone: SOCIETE.telephoneE164,
  email: SOCIETE.email,
  priceRange: '1 500 – 2 500 FCFA',
  currenciesAccepted: 'XOF',
  identifier: { '@type': 'PropertyValue', name: 'RCCM', value: SOCIETE.rccm },
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Yopougon Sable',
    addressLocality: 'Abidjan',
    addressRegion: 'District autonome d’Abidjan',
    addressCountry: 'CI',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'District autonome d’Abidjan' },
    ...COMMUNES.map((c) => ({ '@type': 'City', name: `${c.nom}, Abidjan` })),
  ],
  knowsAbout: ['Livraison de colis', 'Coursier à moto', 'Livraison express', 'Livraison e-commerce'],
  sameAs: [`https://wa.me/${SOCIETE.whatsapp}`],
};
const ariane = fil.length
  ? [
      {
        '@type': 'BreadcrumbList',
        itemListElement: [{ nom: 'Accueil', url: '/' }, ...fil].map((e, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: e.nom,
          item: new URL(e.url, SITE).toString(),
        })),
      },
    ]
  : [];
const donneesStructurees = { '@context': 'https://schema.org', '@graph': [entreprise, ...ariane, ...jsonLd] };
---

<!doctype html>
<html lang="fr-CI">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="geo.region" content="CI-AB" />
    <meta name="geo.placename" content="Abidjan" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#1b2a4a" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CI" />
    <meta property="og:site_name" content={SOCIETE.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content="https://naellys-express.com/images/coursier.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <div class="progression" data-progression aria-hidden="true"></div>
    <Header />
    <main id="contenu" transition:animate="none">
      <slot />
    </main>
    <Footer />
    <WhatsApp />
    <div class="rideau" aria-hidden="true" transition:persist="rideau" data-rideau><span></span></div>
    <script>
      import '../scripts/animations';
      import '../scripts/rideau';
    </script>
  </body>
</html>

<style is:global>
  .evitement { position: absolute; left: 12px; top: -60px; z-index: 100; background: var(--orange); color: #fff; padding: 10px 16px; border-radius: 10px; text-decoration: none; transition: top 0.3s; }
  .evitement:focus { top: 12px; }
  .progression { position: fixed; inset: 0 0 auto; height: 3px; z-index: 60; background: linear-gradient(90deg, var(--orange), #ffb37f); transform-origin: left; transform: scaleX(0); }

  /* Transition entre les pages (scripts/rideau.ts) : un rideau orange et navy couvre l'écran en
     diagonale pendant le chargement, puis se retire en découvrant la nouvelle page. */
  ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
  .rideau { position: fixed; inset: 0; z-index: 90; pointer-events: none; visibility: hidden; }
  .rideau span { position: absolute; inset: -10% -30%; background: linear-gradient(115deg, var(--orange) 0 48%, var(--navy) 48% 100%); transform: translateX(-110%) skewX(-18deg); }
  .rideau.couvre, .rideau.decouvre { visibility: visible; }
  .rideau.couvre span { animation: couvrir 0.42s cubic-bezier(0.7, 0, 0.3, 1) forwards; }
  .rideau.decouvre span { animation: decouvrir 0.62s cubic-bezier(0.7, 0, 0.3, 1) forwards; }
  @keyframes couvrir { from { transform: translateX(-110%) skewX(-18deg); } to { transform: translateX(0) skewX(-18deg); } }
  @keyframes decouvrir { from { transform: translateX(0) skewX(-18deg); } to { transform: translateX(110%) skewX(-18deg); } }
  main { animation: monter 0.8s var(--courbe) both; }
  @keyframes monter { from { opacity: 0; transform: translateY(18px); } }

  @media (prefers-reduced-motion: reduce) {
    .rideau { display: none !important; }
    main { animation: none; }
  }
</style>
