---
// Une page par commune desservie (référencement local, 16/10/2026) : « livraison de colis à Cocody »,
// « coursier à Yopougon »… Contenu propre à chaque commune (src/data/zones.ts).
import Base from '../../layouts/Base.astro';
import EntetePage from '../../components/EntetePage.astro';
import { ZONES, tarifTexte, type Zone } from '../../data/zones';
import { SOCIETE } from '../../data/site';

export function getStaticPaths() {
  return ZONES.map((zone) => ({ params: { commune: zone.slug }, props: { zone } }));
}

const { zone } = Astro.props as { zone: Zone };
const url = `/livraison/${zone.slug}/`;
const voisines = ZONES.filter((z) => z.slug !== zone.slug);
const service = {
  '@type': 'Service',
  name: `Livraison de colis à moto ${zone.a}`,
  serviceType: 'Livraison de colis à moto',
  provider: { '@id': 'https://naellys-express.com/#entreprise' },
  areaServed: { '@type': 'City', name: `${zone.nom}, Abidjan` },
  offers: { '@type': 'Offer', price: zone.tarif, priceCurrency: 'XOF', description: `Tarif sans offre pour une livraison ${zone.a}` },
};
---

<Base
  titre={`Livraison ${zone.a}`}
  titreSeo={`Livraison de colis ${zone.a} (Abidjan) : coursier à moto — ${SOCIETE.nom}`}
  fil={[{ nom: 'Zones desservies', url: '/zones-desservies/' }, { nom: zone.nom, url }]}
  jsonLd={[service]}
  description={`Livraison de colis à moto ${zone.a}, Abidjan : ${tarifTexte(zone.tarif)} sans offre, 2 000 FCFA avec l'offre B2C, livraison le jour même, suivi du coursier en direct et remise par code.`}
>
  <EntetePage
    surtitre={`Livraison de colis à moto ${zone.a}`}
    titre={`Un coursier ${zone.a},<br /><span class='accent'>le jour même.</span>`}
    chapeau={zone.texte}
  />

  <section class="section">
    <div class="conteneur deux-colonnes" style="align-items:start">
      <div>
        <p class="surtitre" data-reveal>Tarif</p>
        <h2 data-reveal style="--delai:60ms">{tarifTexte(zone.tarif)} pour une livraison {zone.a}.</h2>
        <p class="chapeau" data-reveal style="--delai:120ms">
          C’est le tarif sans offre, selon la commune où le colis est livré. Avec l’offre B2C, la course est à 2 000 FCFA partout
          dans les communes desservies. Le prix s’affiche dans l’application avant votre confirmation.
        </p>
        <a class="bouton" href="/tarifs/" data-reveal style="--delai:180ms">Tous les tarifs <span class="fleche" aria-hidden="true">→</span></a>
      </div>
      <div class="carte" data-reveal="droite">
        <h3>Quartiers desservis {zone.a}</h3>
        <ul class="quartiers">{zone.quartiers.map((q) => <li>{q}</li>)}</ul>
        <p class="note">Et toute autre adresse de la commune : placez simplement le point de livraison sur la carte dans l’application.</p>
      </div>
    </div>
  </section>

  <section class="section sombre">
    <div class="raies" aria-hidden="true"><span class="epaisse"></span><span class="fine"></span></div>
    <div class="conteneur">
      <p class="surtitre" data-reveal>Livraison le jour même</p>
      <h2 data-reveal style="--delai:60ms">Trois créneaux par jour {zone.a}.</h2>
      <div class="grille trois" style="margin-top:36px">
        <div class="ligne" data-reveal><h3>Avant 11 h</h3><p>Matin, après-midi ou soir : les trois créneaux sont proposés.</p></div>
        <div class="ligne" data-reveal style="--delai:120ms"><h3>De 11 h à 16 h</h3><p>Livraison l’après-midi ou le soir.</p></div>
        <div class="ligne" data-reveal style="--delai:240ms"><h3>De 16 h à 19 h</h3><p>Livraison le soir même. Après 19 h, à partir du lendemain.</p></div>
      </div>
      <p class="chapeau" style="margin-top:28px">
        Chaque colis est remis contre un code de vérification, et vous suivez votre coursier en direct sur la carte jusqu’à la remise.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="conteneur">
      <p class="surtitre" data-reveal>Vers les autres communes</p>
      <h2 data-reveal style="--delai:60ms">Envoyer un colis depuis {zone.nom}.</h2>
      <p class="chapeau" data-reveal style="--delai:120ms">Nos coursiers relient {zone.nom} à toutes les communes desservies du District d’Abidjan.</p>
      <ul class="voisines" data-reveal style="--delai:180ms">
        {voisines.map((v) => <li><a href={`/livraison/${v.slug}/`}>Livraison {v.a}</a></li>)}
      </ul>
      <div class="boutons">
        <a class="bouton" href="/particuliers/">Envoyer un colis <span class="fleche" aria-hidden="true">→</span></a>
        <a class="bouton contour" href="/entreprises/">Offres entreprises</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .quartiers { display: flex; flex-wrap: wrap; gap: 10px; padding: 0; margin: 18px 0; list-style: none; }
  .quartiers li { padding: 8px 14px; border-radius: 999px; background: var(--surface, #f4f6fa); color: var(--navy); font-weight: 600; font-size: 0.92rem; }
  .note { color: var(--muted); margin: 0; }
  .ligne { padding: 28px; border-radius: 26px; background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.1); }
  .ligne p:last-child { margin: 0; }
  .voisines { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 10px 24px; padding: 0; margin: 26px 0 34px; list-style: none; }
  .voisines a { color: var(--navy); font-weight: 600; text-decoration: none; border-bottom: 2px solid var(--orange); }
  .boutons { display: flex; flex-wrap: wrap; gap: 14px; }
  .bouton.contour { background: transparent; color: var(--navy); box-shadow: inset 0 0 0 2px var(--navy); }
</style>
