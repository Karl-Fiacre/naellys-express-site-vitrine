---
import Base from '../layouts/Base.astro';
import TelephoneSuivi from '../components/TelephoneSuivi.astro';
import Icone from '../components/Icone.astro';
import Telechargement from '../components/Telechargement.astro';
import { COMMUNES, ETAPES, SOCIETE } from '../data/site';

// Position des communes sur la carte stylisée (repère 1000 × 560, nord en haut).
const POSITIONS: Record<string, [number, number]> = {
  Abobo: [470, 90], Yopougon: [210, 220], Attécoubé: [360, 250], Adjamé: [470, 215], Cocody: [640, 200],
  Bingerville: [880, 170], Plateau: [470, 300], Treichville: [470, 380], Marcory: [600, 390], Koumassi: [700, 420],
  'Port-Bouët': [600, 495],
};
---

<Base titre={SOCIETE.nom} description="Livraison de colis à moto dans tout Abidjan : commandez en quelques secondes, suivez votre coursier en direct, remise sécurisée par code. Offres pour particuliers, entreprises et partenaires.">
  <!-- Héros -->
  <section class="hero">
    <div class="fond" aria-hidden="true">
      <div class="halo h1" data-parallaxe="0.18"></div>
      <div class="halo h2" data-parallaxe="-0.1"></div>
      <div class="grille-fond"></div>
      <span class="diag d1"></span><span class="diag d2"></span><span class="diag d3"></span>
    </div>
    <div class="conteneur hero-grille">
      <div class="hero-texte">
        <p class="badge" data-reveal><span class="pulse"></span> Livraison à moto · District d’Abidjan</p>
        <h1 data-reveal style="--delai:80ms">
          Vos colis traversent<br />
          <span class="rotation" aria-live="off">
            {['Cocody', 'le Plateau', 'Yopougon', 'Marcory', 'Abobo', 'Abidjan'].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
          </span><br />
          <span class="texte-degrade">en un éclair.</span>
        </h1>
        <p class="chapeau" data-reveal style="--delai:160ms">
          Commandez en quelques secondes, suivez votre coursier en direct et recevez votre colis en toute sécurité, grâce au code de remise.
        </p>
        <div class="boutons" data-reveal style="--delai:240ms">
          <a class="bouton" href="/contact/" data-aimant>Envoyer un colis <span class="fleche" aria-hidden="true">→</span></a>
          <a class="bouton secondaire" href="/entreprises/">Offres entreprise</a>
        </div>
        <ul class="confiance" data-reveal style="--delai:320ms">
          <li><Icone nom="bouclier" /> Coursiers vérifiés</li>
          <li><Icone nom="suivi" /> Suivi en direct</li>
          <li><Icone nom="code" /> Remise par code</li>
        </ul>
      </div>
      <div class="hero-visuel" data-reveal="zoom" style="--delai:200ms">
        <div class="orbite" aria-hidden="true"><span></span><span></span></div>
        <TelephoneSuivi />
        <div class="bulle prix" aria-hidden="true"><small>Offre B2C</small><strong>2 000 F</strong><span>partout dans Abidjan</span></div>
        <div class="bulle note" aria-hidden="true"><span>✓ Coursier vérifié</span><small>identité, permis, moto</small></div>
      </div>
    </div>
    <a href="#comment" class="descendre" aria-label="Découvrir comment ça marche"><span></span></a>
  </section>

  <!-- Bandeau des communes -->
  <div class="bandeau" aria-label="Communes desservies">
    <div class="defile">
      {[...COMMUNES, ...COMMUNES].map((c) => <span>{c.nom}<i aria-hidden="true">◆</i></span>)}
    </div>
  </div>

  <!-- Comment ça marche -->
  <section class="section" id="comment">
    <div class="conteneur">
      <p class="surtitre" data-reveal>Comment ça marche</p>
      <h2 data-reveal style="--delai:60ms">De votre porte à la sienne,<br />en quatre étapes.</h2>
      <ol class="parcours">
        {ETAPES.map((e, i) => (
          <li data-reveal style={`--delai:${i * 120}ms`}>
            <span class="numero">0{i + 1}</span>
            <span class="icone-disque"><Icone nom={['colis', 'moto', 'suivi', 'code'][i]} /></span>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Carte d'Abidjan -->
  <section class="section sombre carte-abidjan">
    <div class="raies" aria-hidden="true"><span class="epaisse"></span><span class="fine"></span></div>
    <div class="conteneur deux-colonnes">
      <div>
        <p class="surtitre" data-reveal>Notre réseau</p>
        <h2 data-reveal style="--delai:60ms"><span data-compteur="11">11</span> communes,<br />un seul réflexe.</h2>
        <p class="chapeau" data-reveal style="--delai:120ms">De Yopougon à Bingerville, d’Abobo à Port-Bouët : nos coursiers sillonnent tout le District d’Abidjan, chaque jour, du matin au soir.</p>
        <p data-reveal style="--delai:150ms"><a class="lien-zones" href="/zones-desservies/">Voir les zones desservies et les tarifs par commune →</a></p>
        <div class="chiffres" data-reveal style="--delai:180ms">
          <div><strong><span data-compteur="3">3</span></strong><span>créneaux par jour</span></div>
          <div><strong><span data-compteur="48" data-suffixe=" h">48 h</span></strong><span>pour réclamer</span></div>
          <div><strong><span data-compteur="100" data-suffixe=" %">100 %</span></strong><span>coursiers vérifiés</span></div>
        </div>
      </div>
      <figure class="plan" data-reveal="zoom" aria-label="Carte stylisée des communes desservies">
        <svg viewBox="0 0 1000 560" role="img">
          <title>Communes desservies par NAËLLYS EXPRESS</title>
          <defs>
            <linearGradient id="lagune" x1="0" x2="1"><stop offset="0" stop-color="#2c3f66" /><stop offset="1" stop-color="#22355a" /></linearGradient>
            <radialGradient id="lueur"><stop offset="0" stop-color="#e8722c" stop-opacity="0.55" /><stop offset="1" stop-color="#e8722c" stop-opacity="0" /></radialGradient>
          </defs>
          <path class="lagune" d="M0 330 C120 300 200 350 300 325 S420 270 520 335 S700 360 780 320 S920 300 1000 330 L1000 360 C900 345 820 370 760 380 S600 420 520 380 S380 330 300 370 S110 360 0 365Z" fill="url(#lagune)" />
          <path class="mer" d="M0 540 C250 515 500 530 1000 510 L1000 560 L0 560Z" fill="#22355a" />
          <path id="trajet" class="trajet" d="M210 220 C300 230 330 260 360 250 S440 220 470 215 S470 280 470 300 S520 380 600 390 S690 410 700 420" fill="none" />
          {Object.entries(POSITIONS).map(([nom, [x, y]], i) => (
            <g class="commune" style={`--i:${i}`}>
              <circle cx={x} cy={y} r="34" fill="url(#lueur)" class="aura" />
              <circle cx={x} cy={y} r="7" class="point" />
              <text x={x} y={y - 18} text-anchor="middle">{nom}</text>
            </g>
          ))}
          <g class="moto">
            <circle r="13" fill="#e8722c" />
            <path d="M-6 3a3 3 0 1 0 .01 0M6 3a3 3 0 1 0 .01 0M-3 3h5l2-5h-3" stroke="#fff" stroke-width="1.8" fill="none" stroke-linecap="round" />
            <animateMotion dur="7s" repeatCount="indefinite" rotate="0" keyPoints="0;1;1" keyTimes="0;0.85;1" calcMode="linear"><mpath href="#trajet" /></animateMotion>
          </g>
        </svg>
      </figure>
    </div>
  </section>

  <!-- Trois publics -->
  <section class="section">
    <div class="conteneur">
      <p class="surtitre" data-reveal>Pour qui ?</p>
      <h2 data-reveal style="--delai:60ms">Une offre taillée pour chacun.</h2>
      <div class="grille trois publics">
        {[
          { href: '/particuliers/', icone: 'colis', titre: 'Particuliers', texte: 'Un cadeau, un document, une commande : 2 000 FCFA la course avec l’offre B2C, partout dans Abidjan.', lien: 'Découvrir' },
          { href: '/entreprises/', icone: 'entreprise', titre: 'Entreprises', texte: 'Des courses incluses chaque mois, des coursiers salariés en priorité et la facture normalisée électronique (FNE).', lien: 'Voir les formules' },
          { href: '/partenaires/', icone: 'poignee', titre: 'Partenaires', texte: 'Boutiques, restaurants, e-commerçants : un tarif négocié par livraison, sans plafond mensuel.', lien: 'Devenir partenaire' },
        ].map((p, i) => (
          <a class="carte public" href={p.href} data-reveal data-incliner style={`--delai:${i * 120}ms`}>
            <span class="icone-disque"><Icone nom={p.icone} /></span>
            <h3>{p.titre}</h3>
            <p>{p.texte}</p>
            <span class="lien">{p.lien} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Sécurité -->
  <section class="section securite">
    <div class="conteneur deux-colonnes">
      <div class="code-geant" data-reveal="gauche" aria-hidden="true">
        <small>Code de vérification</small>
        <div class="chiffres-code">{['0', '4', '2', '7'].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</div>
        <p>Envoyé par SMS au destinataire.</p>
      </div>
      <div>
        <p class="surtitre" data-reveal>Sécurité</p>
        <h2 data-reveal style="--delai:60ms">Votre colis ne part<br />qu’avec le bon code.</h2>
        <ul class="garanties">
          {[
            ['bouclier', 'Coursiers vérifiés', 'Identité, selfie, permis et papiers de la moto contrôlés par notre équipe.'],
            ['code', 'Remise par code', 'Le colis n’est remis qu’au destinataire qui donne son code à 4 chiffres.'],
            ['photo', 'Photo de preuve', 'Le coursier photographie chaque remise, gardée une semaine.'],
            ['message', 'Service après livraison', 'Une réclamation ? 48 heures pour nous écrire, une réponse dans l’app.'],
          ].map(([icone, titre, texte], i) => (
            <li data-reveal style={`--delai:${i * 100}ms`}>
              <span class="icone-disque"><Icone nom={icone} /></span>
              <div><h3>{titre}</h3><p>{texte}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Témoignage de marque -->
  <section class="section image-marque">
    <div class="conteneur">
      <figure class="cadre-photo" data-reveal="zoom">
        <img src="/images/coursier.jpg" alt="Un coursier NAËLLYS EXPRESS à moto dans Abidjan" loading="lazy" width="1080" height="1920" data-parallaxe="-0.05" />
        <figcaption>
          <p class="surtitre">NAËLLYS EXPRESS</p>
          <blockquote>« {SOCIETE.slogan} »</blockquote>
          <a class="bouton" href="/devenir-livreur/">Rejoindre nos coursiers <span class="fleche" aria-hidden="true">→</span></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <Telechargement />
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: center; background: var(--navy-deep); color: var(--on-navy-muted); overflow: hidden; padding: 130px 0 90px; }
  .fond { position: absolute; inset: 0; }
  .halo { position: absolute; border-radius: 50%; filter: blur(30px); }
  .h1 { width: 70vw; height: 70vw; right: -25vw; top: -30vw; background: radial-gradient(circle, rgb(232 114 44 / 0.35), transparent 62%); }
  .h2 { width: 50vw; height: 50vw; left: -20vw; bottom: -30vw; background: radial-gradient(circle, rgb(44 63 102 / 0.9), transparent 65%); }
  .grille-fond { position: absolute; inset: 0; background-image: linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse at 60% 40%, #000 20%, transparent 75%); }
  .diag { position: absolute; right: -20vw; background: var(--orange); border-radius: 999px; transform: rotate(-32deg) translateX(110%); animation: glisser 1.4s var(--courbe) forwards; }
  .d1 { width: 75vw; height: 34px; top: 66%; animation-delay: 0.3s; }
  .d2 { width: 60vw; height: 12px; top: calc(66% + 64px); opacity: 0.8; animation-delay: 0.45s; }
  .d3 { width: 40vw; height: 4px; top: calc(66% + 100px); opacity: 0.5; animation-delay: 0.6s; }
  @keyframes glisser { to { transform: rotate(-32deg) translateX(0); } }
  .hero-grille { position: relative; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 40px; align-items: center; }
  .hero h1 { color: #fff; }
  .badge { display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px 8px 12px; border-radius: 999px; background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.12); font-size: 0.88rem; font-weight: 500; color: #fff; }
  .pulse { width: 9px; height: 9px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 0 rgb(74 222 128 / 0.7); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px rgb(74 222 128 / 0); } 100% { box-shadow: 0 0 0 0 rgb(74 222 128 / 0); } }
  .rotation { position: relative; display: inline-grid; vertical-align: bottom; height: 1.1em; overflow: hidden; color: #fff; }
  .rotation span { grid-area: 1 / 1; transform: translateY(110%); opacity: 0; animation: tourner-mots 12s var(--courbe) infinite; animation-delay: calc(var(--i) * 2s); }
  @keyframes tourner-mots { 0% { transform: translateY(110%); opacity: 0; } 3%, 16.67% { transform: none; opacity: 1; } 19.67%, 100% { transform: translateY(-110%); opacity: 0; } }
  .hero .chapeau { color: var(--on-navy-muted); margin-top: 8px; }
  .boutons { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .confiance { display: flex; flex-wrap: wrap; gap: 10px 26px; list-style: none; padding: 0; margin: 38px 0 0; color: #fff; font-weight: 500; font-size: 0.95rem; }
  .confiance li { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
  .confiance svg { width: 20px; height: 20px; flex: none; color: var(--orange); }
  .hero-visuel { position: relative; display: grid; place-items: center; }
  .orbite { position: absolute; inset: -6%; display: grid; place-items: center; }
  .orbite span { position: absolute; width: 112%; aspect-ratio: 1; border-radius: 50%; border: 1px dashed rgb(255 255 255 / 0.14); animation: orbite 40s linear infinite; }
  .orbite span:last-child { width: 86%; border-style: solid; border-color: rgb(232 114 44 / 0.25); animation-duration: 28s; animation-direction: reverse; }
  @keyframes orbite { to { transform: rotate(360deg); } }
  .bulle { position: absolute; display: flex; flex-direction: column; padding: 14px 18px; border-radius: 20px; background: rgb(27 42 74 / 0.88); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgb(255 255 255 / 0.18); color: #fff; box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.6); animation: flotter 6s ease-in-out infinite; }
  .bulle small { color: var(--on-navy-muted); font-size: 0.75rem; }
  .prix { right: -4%; bottom: 18%; }
  .prix strong { font-family: var(--font-titre); font-size: 1.6rem; color: var(--orange); line-height: 1.1; }
  .prix span { font-size: 0.78rem; }
  .note { left: -6%; bottom: 6%; animation-delay: -3s; }
  .note span { color: #4ade80; font-weight: 700; }
  @keyframes flotter { 50% { transform: translateY(-14px); } }
  .descendre { position: absolute; left: 50%; bottom: 26px; translate: -50% 0; width: 30px; height: 50px; border-radius: 20px; border: 2px solid rgb(255 255 255 / 0.35); }
  .descendre span { position: absolute; left: 50%; top: 9px; width: 4px; height: 9px; border-radius: 4px; background: var(--orange); translate: -50% 0; animation: molette 1.8s infinite; }
  @keyframes molette { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(16px); } }

  .bandeau { background: var(--orange); color: #fff; overflow: hidden; padding: 18px 0; transform: rotate(-1.2deg) scale(1.02); margin-top: -14px; position: relative; z-index: 2; box-shadow: 0 20px 40px -20px rgb(232 114 44 / 0.6); }
  .defile { display: flex; gap: 0; width: max-content; animation: defiler 34s linear infinite; }
  .defile span { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: var(--font-titre); font-weight: 800; font-size: clamp(1.2rem, 2.4vw, 1.7rem); white-space: nowrap; }
  .defile i { font-style: normal; font-size: 0.7em; opacity: 0.6; }
  .bandeau:hover .defile { animation-play-state: paused; }
  @keyframes defiler { to { transform: translateX(-50%); } }

  .parcours { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; list-style: none; padding: 0; margin: 56px 0 0; counter-reset: etape; }
  .parcours::before { content: ''; position: absolute; left: 6%; right: 6%; top: 88px; height: 2px; background: repeating-linear-gradient(90deg, var(--orange) 0 10px, transparent 10px 20px); opacity: 0.5; }
  .parcours li { position: relative; background: #fff; border-radius: var(--rayon-grand); padding: 30px 26px; box-shadow: var(--ombre-douce); }
  .numero { position: absolute; right: 22px; top: 18px; font-family: var(--font-titre); font-weight: 800; font-size: 2.4rem; color: var(--orange-soft); }
  .parcours p { color: var(--muted); margin: 0; }

  .carte-abidjan { padding-block: clamp(80px, 10vw, 130px); }
  .deux-colonnes { position: relative; display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(30px, 5vw, 70px); align-items: center; }
  .chiffres { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 34px; }
  .chiffres div { padding: 18px; border-radius: 20px; background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.1); }
  .chiffres strong { display: block; font-family: var(--font-titre); font-size: clamp(1.6rem, 3vw, 2.2rem); color: #fff; }
  .chiffres span { font-size: 0.85rem; }
  .plan { margin: 0; padding: 18px; border-radius: 36px; background: rgb(255 255 255 / 0.03); border: 1px solid rgb(255 255 255 / 0.08); box-shadow: inset 0 0 80px rgb(0 0 0 / 0.25); }
  .plan svg { width: 100%; height: auto; overflow: visible; }
  .trajet { stroke: var(--orange); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 10 12; animation: pointilles 1.2s linear infinite; }
  @keyframes pointilles { to { stroke-dashoffset: -22; } }
  .commune .point { fill: #fff; }
  .commune text { fill: var(--on-navy-muted); font-family: var(--font-texte); font-size: 22px; font-weight: 600; }
  .commune .aura { transform-box: fill-box; transform-origin: center; animation: aura 3.2s ease-in-out infinite; animation-delay: calc(var(--i) * 0.28s); }
  @keyframes aura { 50% { transform: scale(1.5); opacity: 0.4; } }

  .publics .public { text-decoration: none; display: flex; flex-direction: column; position: relative; overflow: hidden; }
  .public::after { content: ''; position: absolute; inset: auto -30% -60% auto; width: 260px; height: 260px; border-radius: 50%; background: radial-gradient(circle, rgb(232 114 44 / 0.16), transparent 70%); transition: transform 0.6s var(--courbe); }
  .public:hover::after { transform: scale(1.6); }
  .public p { color: var(--muted); flex: 1; }
  .lien { font-family: var(--font-titre); font-weight: 700; color: var(--orange); }

  .securite { background: linear-gradient(180deg, var(--cream), #fff); }
  .code-geant { position: relative; padding: clamp(30px, 5vw, 56px); border-radius: 40px; background: var(--navy); color: #fff; text-align: center; overflow: hidden; box-shadow: var(--ombre); }
  .code-geant::before { content: ''; position: absolute; width: 140%; height: 40px; background: var(--orange); transform: rotate(-32deg); right: -60%; bottom: 20%; border-radius: 99px; opacity: 0.9; }
  .code-geant small { position: relative; letter-spacing: 0.22em; text-transform: uppercase; color: var(--on-navy-muted); font-size: 0.8rem; }
  .chiffres-code { position: relative; display: flex; justify-content: center; gap: clamp(10px, 2vw, 18px); margin: 24px 0; }
  .chiffres-code span { width: clamp(58px, 9vw, 92px); aspect-ratio: 0.8; display: grid; place-items: center; border-radius: 22px; background: rgb(255 255 255 / 0.08); border: 1.5px solid rgb(255 255 255 / 0.18); font-family: var(--font-titre); font-weight: 800; font-size: clamp(2.2rem, 5vw, 3.6rem); color: var(--orange); animation: saisir 4s var(--courbe) infinite; animation-delay: calc(var(--i) * 0.25s); }
  @keyframes saisir { 0%, 8% { transform: translateY(14px); opacity: 0; } 18%, 85% { transform: none; opacity: 1; border-color: var(--orange); } 100% { opacity: 0; } }
  .code-geant p { position: relative; margin: 0; color: var(--on-navy-muted); }
  .garanties { list-style: none; padding: 0; margin: 30px 0 0; display: grid; gap: 18px; }
  .garanties li { display: flex; gap: 18px; align-items: flex-start; }
  .garanties .icone-disque { flex: none; margin: 0; }
  .garanties h3 { margin-bottom: 4px; }
  .garanties p { color: var(--muted); margin: 0; }

  .image-marque { padding-top: 0; }
  .cadre-photo { position: relative; margin: 0; height: clamp(420px, 60vw, 640px); border-radius: 40px; overflow: hidden; box-shadow: var(--ombre); }
  .cadre-photo img { width: 100%; height: 130%; object-fit: cover; object-position: center 60%; }
  .cadre-photo figcaption { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(28px, 5vw, 64px); background: linear-gradient(0deg, rgb(17 27 49 / 0.95) 10%, rgb(17 27 49 / 0.2) 60%, transparent); }
  .cadre-photo blockquote { margin: 0 0 26px; font-family: var(--font-titre); font-weight: 800; color: #fff; font-size: clamp(1.8rem, 4.4vw, 3.4rem); line-height: 1.05; max-width: 16ch; }
  .cadre-photo .bouton { align-self: flex-start; }

  @media (max-width: 980px) {
    .hero-grille, .deux-colonnes { grid-template-columns: 1fr; }
    .hero-visuel { margin-top: 30px; }
    .parcours { grid-template-columns: 1fr 1fr; }
    .parcours::before { display: none; }
  }
  @media (max-width: 560px) {
    .parcours { grid-template-columns: 1fr; }
    .chiffres { grid-template-columns: 1fr; }
    .bulle.note { display: none; }
    .prix { right: 0; }
  }
  .lien-zones { color: var(--orange); font-weight: 700; text-decoration: none; }
</style>
