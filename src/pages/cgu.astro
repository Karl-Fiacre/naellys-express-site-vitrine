---
import Base from '../layouts/Base.astro';
import EntetePage from '../components/EntetePage.astro';
import { CGU } from '../data/conditions';
import { CONCEPTEUR, SOCIETE } from '../data/site';
---

<Base titre="Conditions générales d’utilisation" fil={[{ nom: 'CGU', url: '/cgu/' }]} description="Conditions générales d'utilisation de l'application et du service de livraison NAËLLYS EXPRESS à Abidjan, et informations légales du site.">
  <EntetePage surtitre="Informations légales" titre="Conditions générales d’utilisation" chapeau="Dernière mise à jour : 16 octobre 2026." />

  <section class="section">
    <div class="conteneur legal carte">
      {CGU.map((partie) => (
        <>
          {partie.titre && <h2>{partie.titre}</h2>}
          {partie.paragraphes?.map((p) => <p>{p}</p>)}
          {partie.points && <ul>{partie.points.map((p) => <li>{p}</li>)}</ul>}
        </>
      ))}
      <h2 id="informations-legales">Informations légales du site</h2>
      <p>
        <strong>Éditeur</strong> : {SOCIETE.nom} — {SOCIETE.siege} — <a href={`tel:${SOCIETE.telephoneE164}`}>{SOCIETE.telephone}</a> —
        <a href={`mailto:${SOCIETE.email}`}>{SOCIETE.email}</a>.
      </p>
      <p>
        <strong>Conception et réalisation</strong> : {CONCEPTEUR.nom} ({CONCEPTEUR.raison}) — site, application et back-office.
        <strong> Hébergement</strong> : le site par Cloudflare, Inc. (cloudflare.com) ; les données de l’application par Supabase Inc.
        (supabase.com), sur des serveurs situés dans l’Union européenne.
      </p>
      <p>
        <strong>Propriété intellectuelle</strong> : la marque NAËLLYS EXPRESS, son logo, ses visuels et les contenus de ce site sont
        protégés ; toute reproduction sans autorisation écrite est interdite.
      </p>
      <p>
        <strong>Formulaires du site</strong> : les informations envoyées (nom, téléphone, email, message) servent uniquement à vous
        répondre et à traiter votre demande, sont conservées le temps de ce traitement, ne sont jamais vendues et sont protégées
        conformément à la loi n° 2013-450 du 19 juin 2013 relative à la protection des données à caractère personnel. Consultation,
        correction ou suppression : <a href={`mailto:${SOCIETE.email}`}>{SOCIETE.email}</a>.
      </p>
      <p>
        <strong>Mesure d’audience</strong> : le site compte lui-même ses visites, sans cookie ni outil tiers (page, type d’appareil,
        pays et ville approximatifs, site d’origine). L’adresse IP n’est jamais conservée ; ces statistiques, réservées à l’équipe,
        sont effacées au bout de 13 mois.
      </p>
      <p class="note">
        Voir aussi la <a href={`${SOCIETE.backOffice}/confidentialite`}>politique de confidentialité</a> de l’application.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal { max-width: 860px; }
  .legal h2 { font-size: 1.3rem; margin-top: 32px; }
  .legal ul { padding-left: 20px; }
  .legal li { margin-bottom: 6px; }
  .legal a { color: var(--orange); font-weight: 600; }
  .note { margin-top: 32px; color: var(--muted); }
</style>
