// Site vitrine publié par Cloudflare Workers (offre gratuite). `npm run build` produit « dist » ;
// `npx wrangler deploy` le publie. Le Worker (worker/index.js) sert les pages et compte les
// visites (16/10/2026) ; les fichiers des dossiers _astro et images sont servis directement.
// Secret à créer dans Cloudflare : VISITES_SECRET (même valeur que dans Supabase).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naellys-express-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/_astro/*", "!/images/*"]
  },
  "vars": {
    "VISITES_URL": "https://hyaxvynyisgmamfdadur.supabase.co/functions/v1/compterVisite"
  }
}
